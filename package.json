{
  "name": "ord-appt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"supabase/functions/**/*.{ts,json}\" \"tests/**/*.mjs\" \"docs/**/*.md\" \"README.md\" \"supabase/README.md\" \".vscode/*.json\" \"package.json\" \"next.config.ts\" \"proxy.ts\" \"eslint.config.mjs\" \"postcss.config.mjs\" \"tsconfig.json\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"supabase/functions/**/*.{ts,json}\" \"tests/**/*.mjs\" \"docs/**/*.md\" \"README.md\" \"supabase/README.md\" \".vscode/*.json\" \"package.json\" \"next.config.ts\" \"proxy.ts\" \"eslint.config.mjs\" \"postcss.config.mjs\" \"tsconfig.json\"",
    "test:ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:rls": "node scripts/verify-rls.mjs",
    "test:onboarding": "node scripts/verify-onboarding.mjs",
    "test:entitlements": "node scripts/verify-entitlements.mjs",
    "types:supabase": "node scripts/generate-supabase-types.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.109.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.3.3",
    "postcss": "^8.5.8",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.25.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
