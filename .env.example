# # Public Supabase browser configuration.
# # Copy these values from Supabase Dashboard > Project Settings > API.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# # Keep the production app on real Supabase authentication.
# NEXT_PUBLIC_ENABLE_DEMO_MODE=false
# Development only. Mock billing is rejected automatically in production.
# BILLING_PROVIDER=mock
# Production must name an installed real provider adapter and supply its
# server-only credentials. Never expose payment secrets with NEXT_PUBLIC_.

# # Server-only transactional email configuration. Never prefix these with
# # NEXT_PUBLIC_ and never commit real values.
# RESEND_API_KEY=re_xxxxxxxxx
# Production sender after mail.yuhbusiness.com is verified in Resend.
# RESEND_FROM_EMAIL=YuhBusiness <notifications@mail.yuhbusiness.com>
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx
# # Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
# CRON_SECRET=replace-with-at-least-16-random-characters
# EMAIL_WEBHOOK_SECRET=replace-with-a-different-random-secret
# Use http://localhost:3000 locally and https://yuhbusiness.com in production.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root used for tenant subdomains, for example yuhbusiness.com.
# NEXT_PUBLIC_ROOT_DOMAIN=localhost
