# # Public Supabase browser configuration.
# # Copy these values from Supabase Dashboard > Project Settings > API.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# # Keep the production app on real Supabase authentication.
# NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# # Server-only transactional email configuration. Never prefix these with
# # NEXT_PUBLIC_ and never commit real values.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=YuhBusiness <onboarding@resend.dev>
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx
# # Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
# CRON_SECRET=replace-with-at-least-16-random-characters
# EMAIL_WEBHOOK_SECRET=replace-with-a-different-random-secret
# NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# # Optional hosted checkout links.
# NEXT_PUBLIC_BEGINNER_CHECKOUT_URL=
# NEXT_PUBLIC_PRO_CHECKOUT_URL=
# NEXT_PUBLIC_ENTERPRISE_CHECKOUT_URL=
